# ==============================================================================
# GINUM Production Environment Variables Template
# Copy this file to .env on the production VPS (/root/ginuma-app/.env)
# Do NOT commit active production passwords or tokens to version control.
# ==============================================================================

# Database Configuration (MySQL 8)
DB_NAME=ginum_apps
DB_PASSWORD=your_strong_mysql_password_here

# Backend Database Connection (Matches DB_PASSWORD or custom db user password)
SPRING_DATASOURCE_PASSWORD=your_strong_mysql_password_here

# Backend Security & Application URLs
DEMO_SEED_TOKEN=your_secure_random_seed_token_here
APP_FRONTEND_URL=https://ginumapps.com

# Mail Configuration (Brevo SMTP)
SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=b88e59001@smtp-brevo.com
SPRING_MAIL_PASSWORD=your_brevo_smtp_key_here
APP_EMAIL_FROM=b88e59001@smtp-brevo.com
